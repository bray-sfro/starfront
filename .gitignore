# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.check-tmp/
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/

# Build output: the folder people run and the zips they download. The
# installers staged for the server to offer are not in git either.
packaging/build/
packaging/dist/
*.zip
server/downloads/*.exe
# The worker and hub binaries: archives, signatures and the manifest are made
# by the release step and never committed (only the .gitkeep folders are).
server/downloads/collab-*/*.tar.gz
server/downloads/collab-*/*.sig
server/downloads/collab-*/latest.json

# Anything an observatory produces or is told: settings, targets, plans,
# the calibration library, logs, frames. None of it belongs in the code.
*.log
*.fits
*.fit
*.xisf
*.db
*.sqlite
*.sqlite3
discord.env
settings.json
targets.json
plan.json
calibration.json
equipment.json

# Scratch that lives beside the project but is not part of it.
rockwood_planetarium*.py
run-test.log

# GasTown 
.gastown-ignore

# Claude Code notes for one machine; CLAUDE.md is the shared guidance.
CLAUDE.local.md
