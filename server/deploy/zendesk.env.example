# Copy to /var/lib/starfront/zendesk.env (owner starfront, mode 600) and fill in.
# The real file never goes in the repository.

STARFRONT_SUPPORT=0
STARFRONT_ZENDESK_SUBDOMAIN=
# Either an OAuth access token limited to tickets:write (preferred) ...
STARFRONT_ZENDESK_OAUTH_TOKEN=
# ... or an agent's email and API token.
STARFRONT_ZENDESK_EMAIL=
STARFRONT_ZENDESK_TOKEN=
STARFRONT_ZENDESK_TAGS=auto-processing,collab-server
# Optional: ids of ticket fields to fill, e.g. {"discord_id": 123, "plan": 456, "project": 789}
STARFRONT_ZENDESK_FIELDS=
STARFRONT_HELP_URL=
