# Discord sign-in for the Starfront collaboration server.
#
# Copy this to the server's data folder as `discord.env`
# (the install script puts it at /var/lib/astrocollab/discord.env),
# fill in the four values, and restart the service:
#     sudo systemctl restart astrocollab
#
# From https://discord.com/developers/applications -> your application -> OAuth2.
# The redirect URL you add there must be exactly:
#     https://<your-host>/auth/discord/callback
ASTROCOLLAB_DISCORD_CLIENT_ID=
ASTROCOLLAB_DISCORD_CLIENT_SECRET=

# Your Discord server's id (Server Settings -> Widget, or right-click the
# server with Developer Mode on -> Copy Server ID). Only its members can sign in.
ASTROCOLLAB_DISCORD_GUILD=

# Optional: a role id somebody must hold to *start* collaborations. Anyone in
# the server can join one regardless. Blank means any member may start one.
ASTROCOLLAB_DISCORD_ROLE=

# Who runs this server: Discord user ids, comma-separated. They sign in like
# everybody else and can change or close anything. (Right-click your own name
# in Discord with Developer Mode on -> Copy User ID.)
ASTROCOLLAB_DISCORD_OWNERS=

# Where this server is reachable from the outside, https, no trailing slash.
ASTROCOLLAB_PUBLIC_URL=https://collab.example.org
