[Unit]
Description=Starfront collaboration server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starfront
Group=starfront
WorkingDirectory=/opt/starfront
Environment=STARFRONT_DATA=/var/lib/starfront
# Loopback only: Caddy in front of it does TLS and is what the world talks to.
ExecStart=/opt/starfront/venv/bin/python server/run.py --host 127.0.0.1 --port 8800
Restart=always
RestartSec=3
# The admin token and the Discord secret live in /var/lib/starfront and
# nowhere else; the program folder is read-only to the service.
ProtectSystem=strict
# The files folder is named as well as its parent so that a block-storage
# volume mounted there is writable too.
ReadWritePaths=/var/lib/starfront /var/lib/starfront/files
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
