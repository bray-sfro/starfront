# Copy to /var/lib/starfront/billing.env (owner starfront, mode 600) and fill in.
# The real file never goes in the repository. Leave out any line you do not use:
# a door with no secret stays shut.

STARFRONT_BILLING=0

# Shopify admin > Settings > Notifications > Webhooks: the signing secret shown there.
STARFRONT_SHOPIFY_WEBHOOK_SECRET=

# Appstle > More > Webhook Integration > webhook portal: the endpoint's signing secret (starts whsec_).
STARFRONT_APPSTLE_WEBHOOK_SECRET=

# Only if a Shopify Flow "Send HTTP request" step is used: a long random string,
# the same one typed into the step's X-Starfront-Secret header.
STARFRONT_FLOW_SECRET=

# Appstle > API key (read-only is enough), for the nightly reconcile.
STARFRONT_APPSTLE_API_KEY=
