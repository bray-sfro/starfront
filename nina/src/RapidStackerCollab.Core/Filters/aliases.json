  "patterns": [
    {"id": "ha-words", "regex": "^(?:h(?:a|alpha|ii)|hydrogen(?:alpha)?)(?:line|pass|band)?$", "canonical": "HA", "requires_bandwidth": false},
    {"id": "hb-words", "regex": "^(?:h(?:b|beta)|hydrogenbeta)(?:line|pass|band)?$", "canonical": "HB", "requires_bandwidth": false},
    {"id": "oiii-words", "regex": "^(?:o(?:3|iii|ii)|oxygen(?:3|iii|ii)?)(?:line|pass|band|doublet)?$", "canonical": "OIII", "requires_bandwidth": false},
    {"id": "sii-words", "regex": "^(?:s(?:2|ii)|sul(?:ph|f)ur(?:2|ii)?)(?:line|pass|band)?$", "canonical": "SII", "requires_bandwidth": false},
    {"id": "nii-words", "regex": "^(?:n(?:2|ii)|nitrogen(?:2|ii)?)(?:line|pass|band)?$", "canonical": "NII", "requires_bandwidth": false},
    {"id": "luminance-ircut", "regex": "^(?:l|lum|luminance)[123]?(?:uvir|ircut|uvircut|irblock|uvirblock)$", "canonical": "L", "requires_bandwidth": false},
    {"id": "ircut-words", "regex": "^(?:uvir(?:cut|block(?:ing)?)?|ir(?:cut|block(?:ing)?))$", "canonical": "L", "requires_bandwidth": false},
    {"id": "clear-with-ircut", "regex": "^(?:clear|clearglass|open)(?:with|w|plus)?(?:uvir|ir|uv)(?:cut|block(?:ing)?)$", "canonical": "L", "requires_bandwidth": false},
    {"id": "lrgb-l", "regex": "^lrgb(?:l|lum|luminance)$", "canonical": "L", "requires_bandwidth": false},
    {"id": "lrgb-r", "regex": "^lrgb(?:r|red)$", "canonical": "R", "requires_bandwidth": false},
    {"id": "lrgb-g", "regex": "^lrgb(?:g|green)$", "canonical": "G", "requires_bandwidth": false},
    {"id": "lrgb-b", "regex": "^lrgb(?:b|blue)$", "canonical": "B", "requires_bandwidth": false},
    {"id": "clear-words", "regex": "^(?:(?:no|without)(?:any)?(?:installed|inplace)?|(?:clear|empty|open)(?:slot|position|pos|hole|glass|aperture))$", "canonical": "CLEAR", "requires_bandwidth": false},
    {"id": "duo-combination", "regex": "^(?:ha|halpha|oiii|o3|sii|s2)[+&]?(?:ha|halpha|oiii|o3|sii|s2)(?:[+&]?(?:ha|halpha|oiii|o3|sii|s2))?$", "canonical": "DUO", "requires_bandwidth": false},
    {"id": "duo-words", "regex": "^(?:dual|duo|twin|double|2)(?:band|bandpass|narrowband|narrow|nb)$", "canonical": "DUO", "requires_bandwidth": false},
    {"id": "multi-band-words", "regex": "^(?:tri|triple|three|3|quad|quadruple|four|4|penta|five|multi)(?:band|bandpass|narrowband|narrow|nb)$", "canonical": "DUO", "requires_bandwidth": false},
    {"id": "ir-pass-number", "regex": "^ir(?:pass)?[0-9]{3,4}$", "canonical": "IR", "requires_bandwidth": false},
    {"id": "u-band", "regex": "^uband$", "canonical": "U", "requires_bandwidth": false},
    {"id": "v-band", "regex": "^vband$", "canonical": "V", "requires_bandwidth": false},
    {"id": "i-band", "regex": "^iband$", "canonical": "I", "requires_bandwidth": false},
    {"id": "z-band", "regex": "^zband$", "canonical": "Z", "requires_bandwidth": false},
    {"id": "y-band", "regex": "^yband$", "canonical": "Y", "requires_bandwidth": false},
    {"id": "bare-h-with-bandwidth", "regex": "^h$", "canonical": "HA", "requires_bandwidth": true},
    {"id": "bare-o-with-bandwidth", "regex": "^o$", "canonical": "OIII", "requires_bandwidth": true},
    {"id": "bare-s-with-bandwidth", "regex": "^s$", "canonical": "SII", "requires_bandwidth": true},
    {"id": "bare-n-with-bandwidth", "regex": "^n$", "canonical": "NII", "requires_bandwidth": true}
  ],
  "stream_keys": {
    "grammar": "canonical [\"@osc\"] [\"@\" (\"unk\" | number \"nm\")]; number = int [\".\" 1-2 digits, no trailing zero]; @osc before the bandwidth; bandwidth only on narrowband canonicals and only when merge_bandwidths is false; @osc only when the sensor is Bayer and merge_osc_channels is false, never on OSC",
    "regex": "^[A-Z]+(?:@osc)?(?:@(?:unk|[0-9]+(?:\\.[0-9]{1,2})?nm))?$",
    "narrowband": ["HA", "OIII", "SII", "HB", "NII", "DUO"]
  }
}
