  "resolution": {
    "order": ["override", "contributor", "alias", "pattern", "single_letter", "sensor", "filename", "quarantine"],
    "override_and_contributor": "exact match on the RAW string (no folding). Override map first, then contributor map. Result confidence `user`, step `override` / `contributor`. They win outright, including over the sensor rule.",
    "alias": "if the string is not blank: look key up in `aliases` (by key). Confidence `exact`. The vendor is the alias vendor, else the detected vendor.",
    "pattern": "else try `patterns` in order against key; a rule with requires_bandwidth is skipped unless a bandwidth was found. First match wins. Confidence `pattern`.",
    "photometric_gate": {
      "canonicals": ["IR", "UV", "U", "V", "I", "Z", "Y"],
      "rule": "an alias or pattern hit whose canonical is listed here is discarded (the string stays unresolved, steps 5 and 6 are NOT tried) unless the project declares that canonical"
    },
    "single_letter": {"applies_when": "key is exactly one character and has an entry in `single_letters`", "rule": "If sloan and the letter is one of u g r i z: unresolved unless project.photometric; if project.photometric then g gives G and r gives R, and u i z give U I Z only if declared. Otherwise: if the letter is g and project.photometric then unresolved and flagged ambiguous; else accepted if the project declares its canonical. Confidence `inferred`.", "photometric_project": "the project declares at least one of U V I Z Y"},
    "sensor": {
      "applies_when": "the frame has a BAYERPAT header",
      "rule": "if the string is empty (absent or blank), or the resolved canonical is L or CLEAR, or nothing resolved and the key is `l` or `c` (and not sloan): result OSC, confidence `inferred`, step `sensor`. DUO stays DUO. Overrides and contributor mappings are not touched.",
      "from": ["L", "CLEAR"],
      "bare_letters": ["l", "c"],
      "to": "OSC"
    },
    "filename": {
      "applies_when": "the FILTER string is absent or blank, and the camera is not a Bayer sensor",
      "basename_separators": ["/", "\\"],
      "split_regex": "[_.\\- ]+",
      "rule": "take the last path component, fold it, split on split_regex, drop empty tokens. For i = 0..n: try token[i]+token[i+1] (when it exists) and then token[i], each through prepare -> alias -> pattern -> single_letter (same gates). First hit wins: confidence `inferred`, step `filename`. bandwidth, if not already known, is read from the folded last path component."
    },
    "empty_filter": "a present but blank string with nothing from the filename resolves to CLEAR (confidence `inferred`, step `empty`); an absent one to UNKNOWN",
    "quarantine": "everything else: UNKNOWN, confidence `inferred`, step `quarantine`; vendor and bandwidth are still reported"
  },
