  "text": {
    "steps": ["fold: NFKC, lower-case, replace `fold.replace`, collapse whitespace runs to one space, trim", "blank = (folded text with every whitespace and strip character removed) is empty", "sloan = sloan_prime_regex matches the folded text", "delete every match of range_regex from the folded text (replace by a space)", "bandwidth = first match of bandwidth.regex whose group-1 number (decimal comma read as a point) is > bandwidth.min_exclusive_nm and <= bandwidth.max_nm; then delete every match of bandwidth.regex (replace by a space)", "key = the text with every whitespace character and every character of strip_chars deleted", "delete every match of residual_nm_regex from key", "vendors, in order: if the vendor regex matches key, vendor = first such vendor; delete every match from key", "sloan = sloan or sloan_word_regex matches key", "noise, in order: delete every match of the regex from key"],
    "fold": {
      "unicode_normalization": "NFKC",
      "lowercase": true,
      "replace": [
        {"from": "\u03b1", "to": "a"},
