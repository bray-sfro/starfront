<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Plugin.props" />
  <PropertyGroup>
    <RootNamespace>Starfront.Collab</RootNamespace>
    <AssemblyName>Starfront.Collab</AssemblyName>
    <!-- NuGet runtime dependencies land in the build output, so the package
         script can pick up the ones the plugin owns. N.I.N.A.'s own assemblies
         are never bundled; see build/Plugin.targets. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="$(NinaPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Live stacking: the Rapid Stacker Collab upload engine, copied from
         that project (see src/RapidStackerCollab.Core/SOURCE.md). Ships in the
         zip beside this assembly, with its SQLite dependencies. -->
    <ProjectReference Include="../RapidStackerCollab.Core/RapidStackerCollab.Core.csproj" />
  </ItemGroup>
  <Import Project="../../build/Plugin.targets" />
</Project>
