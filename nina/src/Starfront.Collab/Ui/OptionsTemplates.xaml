<ResourceDictionary
    x:Class="Starfront.Collab.Ui.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Starfront.Collab.Ui">

    <local:ShowWhenTrue x:Key="Starfront_ShowWhenTrue" />
    <local:ShowWhenFalse x:Key="Starfront_ShowWhenFalse" />
    <local:ShowWhenSomething x:Key="Starfront_ShowWhenSomething" />

    <!--  Keyed by the plugin's title in code-behind, as N.I.N.A. looks it up.  -->
    <DataTemplate x:Key="Starfront_OptionsTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="10" HorizontalAlignment="Left">

                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Starfront" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.8"
                    Text="Several telescopes on one target - a single field or a mosaic. Sign in with Discord, join a collaboration on the Starfront panel of the Imaging tab, and put the Starfront collaboration container in your sequence where a target would go."
                    TextWrapping="Wrap" />

                <!--  Sign in  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Account" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Settings.Enrolled, Converter={StaticResource Starfront_ShowWhenFalse}}">
                    <Button
                        MinWidth="180"
                        Padding="12,6"
                        Command="{Binding SignInCommand}"
                        Content="Sign in with Discord" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Command="{Binding JoinDiscordCommand}"
                        Content="Join the Starfront Discord"
                        ToolTip="Opens the invitation in your browser. You need to be in the server to sign in." />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="You have to be in the Starfront Discord server to take part; you do not have to be a Starfront customer. Anyone in the server can join and start collaborations. A browser window opens; come back here when it says you are signed in." TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Settings.Enrolled, Converter={StaticResource Starfront_ShowWhenTrue}}">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Signed in as " /><Run FontWeight="SemiBold" Text="{Binding Settings.UserName, Mode=OneWay}" /><Run Text="; this telescope is enrolled as " /><Run FontWeight="SemiBold" Text="{Binding Settings.AgentName, Mode=OneWay}" /><Run Text="." />
                    </TextBlock>
                    <Button
                        Margin="12,0,0,0"
                        Padding="10,4"
                        Command="{Binding SignOutCommand}"
                        Content="Sign out" />
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.8"
                    Text="{Binding Session.SignInStatus}"
                    TextWrapping="Wrap"
                    Visibility="{Binding Session.SignInStatus, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                <!--  Signing in checks in, and the plugin keeps checking in on its own; there is no button for it.  -->
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding Session.StatusText}" />
                </StackPanel>

                <!--  Exposures  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Your exposures" />
                <TextBlock
                    Opacity="0.8"
                    Text="{Binding Exposures.Hint}"
                    TextWrapping="Wrap" />
                <DataGrid
                    MaxHeight="280"
                    Margin="0,6,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding Exposures.Rows}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Name, Mode=OneWay}"
                            Header="Filter"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="*" Header="Delivers">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding DeliveryChoices}"
                                        SelectedValue="{Binding Delivers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Code" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Seconds, ValidatesOnExceptions=True}"
                            Header="Seconds per sub" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.7"
                    Text="A project may set a shortest or longest sub it will take; if yours falls outside, joining tells you which filter to change. Gain, offset and binning below are what the frames are taken with."
                    TextWrapping="Wrap" />

                <!--  Camera  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Camera" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Gain (-1 = camera default)" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Gain, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Offset (-1 = camera default)" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Offset, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Binning" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Binning, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Dither after every N frames" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding Settings.DitherEvery, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="0 leaves dithering to the triggers around the container" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Recentre after drifting (arcmin)" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding Settings.RecentreArcMinutes, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="each field checks its own drift between frames; 0 never recentres. Do not add Center after drift above the container: it would use another target's coordinates" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Rotate to the project's angle" />
                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.MatchRotation}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="when a rotator is connected; a fixed camera shoots at the angle it sits" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Camera angle (no rotator)" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" Text="{Binding Settings.CameraAngleText}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="read from the first plate solve of each field; on a mosaic the server lays your panels along the camera's axes" TextWrapping="Wrap" />
                </Grid>

                <!--  Telescope  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="This telescope" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Name on the chart" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.TelescopeName}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the profile's name unless you type one" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Show where I point" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.SharePosition}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the mount's RA and Dec and what it is doing, for the others' charts; never your site" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Upload my collaboration lights" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.AutoUpload}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="each light shot for a collaboration goes to the server the moment N.I.N.A. saves it, in the background; your files are never changed or deleted" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Bortle class of the sky" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Bortle, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="1 is the darkest sky, 9 an inner city; 0 is not rated. A project may ask for a dark sky." TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
