<ResourceDictionary
    x:Class="Starfront.Collab.Ui.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Starfront.Collab.Ui">

    <local:ShowWhenTrue x:Key="Starfront_ShowWhenTrue" />
    <local:ShowWhenFalse x:Key="Starfront_ShowWhenFalse" />
    <local:ShowWhenSomething x:Key="Starfront_ShowWhenSomething" />

    <!--  Keyed by the plugin's title in code-behind, as N.I.N.A. looks it up.  -->
    <DataTemplate x:Key="Starfront_OptionsTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="10" HorizontalAlignment="Left">

                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Starfront" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.8"
                    Text="Several telescopes on one target - a single field or a mosaic. Sign in with Discord, join a collaboration on the Starfront panel of the Imaging tab, and put the Starfront collaboration container in your sequence where a target would go."
                    TextWrapping="Wrap" />

                <!--  Sign in  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Account" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Settings.Enrolled, Converter={StaticResource Starfront_ShowWhenFalse}}">
                    <Button
                        MinWidth="180"
                        Padding="12,6"
                        Command="{Binding SignInCommand}"
                        Content="Sign in with Discord" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Command="{Binding JoinDiscordCommand}"
                        Content="Join the Starfront Discord"
                        ToolTip="Opens the invitation in your browser. You need to be in the server to sign in." />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="You have to be in the Starfront Discord server to take part; you do not have to be a Starfront customer. Anyone in the server can join and start collaborations. A browser window opens; come back here when it says you are signed in." TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Settings.Enrolled, Converter={StaticResource Starfront_ShowWhenTrue}}">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Signed in as " /><Run FontWeight="SemiBold" Text="{Binding Settings.UserName, Mode=OneWay}" /><Run Text="; this telescope is enrolled as " /><Run FontWeight="SemiBold" Text="{Binding Settings.AgentName, Mode=OneWay}" /><Run Text="." />
                    </TextBlock>
                    <Button
                        Margin="12,0,0,0"
                        Padding="10,4"
                        Command="{Binding SignOutCommand}"
                        Content="Sign out" />
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.8"
                    Text="{Binding Session.SignInStatus}"
                    TextWrapping="Wrap"
                    Visibility="{Binding Session.SignInStatus, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                <!--  Signing in checks in, and the plugin keeps checking in on its own; there is no button for it.  -->
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding Session.StatusText}" />
                </StackPanel>

                <!--  Exposures  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Your exposures" />
                <TextBlock
                    Opacity="0.8"
                    Text="{Binding Exposures.Hint}"
                    TextWrapping="Wrap" />
                <DataGrid
                    MaxHeight="280"
                    Margin="0,6,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding Exposures.Rows}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding Name, Mode=OneWay}"
                            Header="Filter"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="*" Header="Delivers">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding DeliveryChoices}"
                                        SelectedValue="{Binding Delivers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Code" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Seconds, ValidatesOnExceptions=True}"
                            Header="Seconds per sub" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.7"
                    Text="A project may set a shortest or longest sub it will take; if yours falls outside, joining tells you which filter to change. Gain, offset and binning below are what the frames are taken with."
                    TextWrapping="Wrap" />

                <!--  Camera  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Camera" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Gain (-1 = camera default)" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Gain, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Offset (-1 = camera default)" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Offset, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Binning" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Binning, ValidatesOnExceptions=True}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Dither after every N frames" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding Settings.DitherEvery, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="0 leaves dithering to the triggers around the container" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Recentre after drifting (arcmin)" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding Settings.RecentreArcMinutes, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="each field checks its own drift between frames; 0 never recentres. Do not add Center after drift above the container: it would use another target's coordinates" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Rotate to the project's angle" />
                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.MatchRotation}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="when a rotator is connected; a fixed camera shoots at the angle it sits" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Camera angle (no rotator)" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" Text="{Binding Settings.CameraAngleText}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="read from the first plate solve of each field; on a mosaic the server lays your panels along the camera's axes" TextWrapping="Wrap" />
                </Grid>

                <!--  Telescope  -->
                <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="This telescope" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Name on the chart" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.TelescopeName}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the profile's name unless you type one" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Show where I point" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.SharePosition}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the mount's RA and Dec and what it is doing, for the others' charts; never your site" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Bortle class of the sky" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.Bortle, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="1 is the darkest sky, 9 an inner city; 0 is not rated. A project may ask for a dark sky." TextWrapping="Wrap" />
                </Grid>

                <!--  Live stacking: the lights of a linked collaboration sent to Rapid Stacker Collab as they land.
                      Off by default; off, nothing below is connected, opened or read.  -->
                <StackPanel DataContext="{Binding Stacking}">
                    <TextBlock Margin="0,18,0,4" FontWeight="SemiBold" Text="Live stacking" />
                    <TextBlock
                        Opacity="0.8"
                        Text="A collaboration's coordinator can have its lights stacked as they land by Rapid Stacker Collab. With this on, every light the Starfront container saves for such a collaboration is sent there - a copy, with your location taken out - and the stack grows through the night. Nothing else on this PC is sent, and your own files are never moved, changed or deleted."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <!--  N.I.N.A.'s theme draws a CheckBox as a bare switch, so the label sits beside it.  -->
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.StackingEnabled}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Send my lights to live stacking" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Opacity="0.7"
                        Text="Turning this on joins this telescope to the stacking project of each linked collaboration you are on, and joining accepts Rapid Stacker Collab's terms of contribution as they stand; read them on its website first."
                        TextWrapping="Wrap" />

                    <StackPanel IsEnabled="{Binding Settings.StackingEnabled}">
                        <!--  The Rapid Stacker Collab account, separate from the Discord one above.  -->
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Rapid Stacker Collab account" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding SignIn.SignedIn, Converter={StaticResource Starfront_ShowWhenFalse}}">
                            <Button MinWidth="180" Padding="12,6" Command="{Binding SignInCommand}" Content="Sign in to Rapid Stacker Collab" />
                            <TextBlock
                                Margin="12,0,0,0"
                                MaxWidth="400"
                                VerticalAlignment="Center"
                                Opacity="0.8"
                                Text="A browser window opens with a code to approve. No password is typed into N.I.N.A."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding SignIn.SignedIn, Converter={StaticResource Starfront_ShowWhenTrue}}">
                            <TextBlock VerticalAlignment="Center" Text="{Binding SignIn.AccountText}" />
                            <Button Margin="12,0,0,0" Padding="10,4" Command="{Binding SignOutCommand}" Content="Sign out" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding SignIn.Waiting, Converter={StaticResource Starfront_ShowWhenTrue}}">
                            <TextBlock VerticalAlignment="Center" Text="Code: " />
                            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding SignIn.UserCode}" />
                            <Button Margin="12,0,0,0" Padding="10,4" Command="{Binding OpenBrowserCommand}" Content="Open the browser again" />
                            <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding CancelSignInCommand}" Content="Cancel" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Opacity="0.8" Text="{Binding SignIn.Status}" TextWrapping="Wrap" Visibility="{Binding SignIn.Status, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                        <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding SignIn.ExpiryText}" TextWrapping="Wrap" Visibility="{Binding SignIn.ExpiryText, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.7" Text="Hub projects need no Rapid Stacker Collab sign-in." TextWrapping="Wrap" />

                        <!--  When and how the uploads run.  -->
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Uploads" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Send" />
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,4"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Modes}"
                                SelectedValue="{Binding Settings.StackingUploadMode, Mode=TwoWay}"
                                SelectedValuePath="Code" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="idle means between exposures, so an upload never competes with a download from the camera" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Window opens (HH:mm)" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingWindowStart, ValidatesOnExceptions=True}" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="local time; a window may cross midnight" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Window closes (HH:mm)" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingWindowEnd, ValidatesOnExceptions=True}" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the same time as the start means all day" Visibility="{Binding UsesWindow, Converter={StaticResource Starfront_ShowWhenTrue}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Wait after each image (s)" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingIdleGraceSeconds, ValidatesOnExceptions=True}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="when sending while idle: how long after a frame lands before an upload starts, 0 to 600" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Speed limit (KB/s)" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingBandwidthKBps, ValidatesOnExceptions=True}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="0 is no limit; changes take effect at once" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Take my location out" />
                            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.StackingStripLocation}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the site's latitude, longitude and height, the observer, and the altitude and azimuth that would give them away; a project may insist" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Send flats" />
                            <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.StackingUploadFlats}" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="each to the projects that got this telescope's lights of the same filter that night; an evening flat waits for them, and a night spent on another target keeps its flats here" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Also send darks, bias" />
                            <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.StackingIncludeCalibration}" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="to the project of the last light sent, when they do not go to the calibration library below" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Name on the stack" />
                            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingDisplayName}" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="who the frames are credited to; blank uses your Discord name. Used when joining." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Rapid Stacker Collab server" />
                            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingApiBase}" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="leave it as it is unless you were told otherwise" TextWrapping="Wrap" />
                        </Grid>

                        <!--  The rig's calibration library: darks, bias and dark flats kept once, for every project.  -->
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Calibration library" />
                        <TextBlock
                            Opacity="0.8"
                            Text="Rapid Stacker Collab keeps this telescope's bias, darks and dark flats once and calibrates its lights in every project with them, so they need not be sent to each project. The library belongs to this telescope's rig, which is made when it first joins a stacking project."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Send new darks there" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.StackingLibraryLive}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the darks, bias and dark flats N.I.N.A. saves go to the library instead of a project" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Calibration folder" />
                            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" LastChildFill="True">
                                <Button Margin="8,0,0,0" Padding="10,2" Command="{Binding BrowseLibraryCommand}" Content="Browse..." DockPanel.Dock="Right" />
                                <TextBox Text="{Binding Settings.StackingLibraryFolder}" />
                            </DockPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Sync every (hours)" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding Settings.StackingLibrarySyncHours, ValidatesOnExceptions=True}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="the folder is kept in step with the library: a master per group if it has one, else the raw frames; nothing is ever removed from the library by the plugin" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Prefer raw frames" />
                            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,4" VerticalAlignment="Center" IsChecked="{Binding Settings.StackingLibraryPreferRaw}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center" Opacity="0.7" Text="send the raw frames even where a master exists, for masters made by tools that already took the bias out" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Button Padding="10,4" Command="{Binding SyncLibraryNowCommand}" Content="Sync the library now" />
                            <TextBlock Margin="12,0,0,0" MaxWidth="520" VerticalAlignment="Center" Text="{Binding LibraryStatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding LibraryDetailText}" TextWrapping="Wrap" Visibility="{Binding LibraryDetailText, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                        <TextBlock Margin="0,4,0,0" Opacity="0.85" Text="{Binding LibraryProblemsText}" TextWrapping="Wrap" Visibility="{Binding LibraryProblemsText, Converter={StaticResource Starfront_ShowWhenSomething}}" />

                        <!--  Every collaboration with a stacking project, and how this telescope stands with it.  -->
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Linked collaborations" />
                        <TextBlock
                            Opacity="0.7"
                            Text="None yet. Stacking follows the collaboration: when one you are on is stacked (on a hub, or on Rapid Stacker Collab), this telescope joins its stacking project at the next check-in."
                            TextWrapping="Wrap"
                            Visibility="{Binding HasLinks, Converter={StaticResource Starfront_ShowWhenFalse}}" />
                        <ItemsControl ItemsSource="{Binding Links}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,6">
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Project, Mode=OneWay}" /><Run Text="{Binding BackendText, Mode=OneWay, StringFormat=' ({0})'}" />
                                        </TextBlock>
                                        <TextBlock Opacity="0.85" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.7" Text="{Binding MappingText}" TextWrapping="Wrap" Visibility="{Binding MappingText, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                                        <TextBlock Opacity="0.7" Text="{Binding RetryText}" TextWrapping="Wrap" Visibility="{Binding RetryText, Converter={StaticResource Starfront_ShowWhenSomething}}" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding TermsOutdated, Converter={StaticResource Starfront_ShowWhenTrue}}">
                                            <Button Padding="10,2" Command="{Binding ReadTermsCommand}" Content="Read the new terms" />
                                            <Button Margin="8,0,0,0" Padding="10,2" Command="{Binding AcceptTermsCommand}" Content="Accept them and carry on" />
                                        </StackPanel>
                                        <Button Margin="0,4,0,0" HorizontalAlignment="Left" Padding="10,2" Command="{Binding RetryCommand}" Content="Retry now" Visibility="{Binding CanRetry, Converter={StaticResource Starfront_ShowWhenTrue}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
