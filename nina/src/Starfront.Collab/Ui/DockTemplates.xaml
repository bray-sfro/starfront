<ResourceDictionary
    x:Class="Starfront.Collab.Ui.DockTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Starfront.Collab.Ui">

    <local:ShowWhenTrue x:Key="Starfront_Dock_ShowWhenTrue" />
    <local:ShowWhenFalse x:Key="Starfront_Dock_ShowWhenFalse" />
    <local:ShowWhenSomething x:Key="Starfront_Dock_ShowWhenSomething" />

    <!--  Keyed by the view model's full type name plus _Dockable, as the host looks it up.  -->
    <DataTemplate x:Key="Starfront.Collab.Ui.StarfrontDockVM_Dockable">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">

                <!--  Signing in checks in, and the plugin keeps checking in on its own; there is no button for it.  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Opacity="0.85" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <Button
                        Margin="10,0,0,0"
                        Padding="8,2"
                        Command="{Binding SignInCommand}"
                        Content="Sign in with Discord"
                        Visibility="{Binding Enrolled, Converter={StaticResource Starfront_Dock_ShowWhenFalse}}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0" Opacity="0.7" Text="{Binding OnlineText}" Visibility="{Binding OnlineText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding Message}"
                    TextWrapping="Wrap"
                    Visibility="{Binding Message, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />

                <!--  The run: every field of tonight's deal with where it has got to, live.  -->
                <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="{Binding RunText}" Visibility="{Binding RunText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                <ItemsControl ItemsSource="{Binding PlanLines}" Visibility="{Binding ShowPlan, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Opacity="0.9" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Tonight's deal" />
                <ItemsControl ItemsSource="{Binding Tonight}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Live stacking: what is waiting, what is going, why it holds, the last thing that happened.
                      Only while it is turned on; the queue is read only while this panel is open.  -->
                <StackPanel DataContext="{Binding Stacking}" Visibility="{Binding Visible, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                    <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Live stacking" />
                    <TextBlock Opacity="0.85" Text="{Binding Headline}" TextWrapping="Wrap" Visibility="{Binding Headline, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBlock Opacity="0.85" Text="{Binding CurrentText}" TextWrapping="Wrap" Visibility="{Binding CurrentText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBlock Opacity="0.7" Text="{Binding ReasonText}" TextWrapping="Wrap" Visibility="{Binding ReasonText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBlock Opacity="0.7" Text="{Binding LastText}" TextWrapping="Wrap" Visibility="{Binding LastText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBlock Opacity="0.7" Text="{Binding CalibrationText}" TextWrapping="Wrap" Visibility="{Binding CalibrationText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding Hint}" TextWrapping="Wrap" Visibility="{Binding Hint, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <!--  Projects whose uploads the queue is holding. Their lights are still queued, so without these rows the
                          dock showed them only as waiting; Resume lifts the hold, and the next upload says if the cause remains.  -->
                    <ItemsControl ItemsSource="{Binding Held}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Opacity="0.85" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="8,1"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.ResumeProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Resume"
                                        ToolTip="Send this project's lights again now; if the cause is still there, the next upload holds it again" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <Button Padding="8,1" Command="{Binding TogglePauseCommand}" Content="{Binding PauseLabel}" />
                        <Button Margin="8,0,0,0" Padding="8,1" Command="{Binding UploadNowCommand}" Content="Upload now" ToolTip="Send what is waiting now, whatever the mode says; the pause still holds" />
                    </StackPanel>
                </StackPanel>

                <!--  Starting one. Anybody signed in may; the form sends the same request the Starfront program does.  -->
                <Expander
                    Margin="0,12,0,0"
                    IsExpanded="{Binding Start.Open, Mode=TwoWay}"
                    Visibility="{Binding CanStart, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Start.Title}" />
                    </Expander.Header>
                    <StackPanel Margin="4,6,4,4" MaxWidth="420" HorizontalAlignment="Left" DataContext="{Binding Start}">
                        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Name it, say where it is and what you want collected, and it is open to every telescope on the server that qualifies. You can edit it, close it or deal it afresh from here afterwards." />

                        <TextBlock Margin="0,8,0,2" Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,8,0,2" Text="Where" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding FromFramingCommand}" Content="From Framing Assistant" ToolTip="Take the target the Framing Assistant is showing, with its angle" />
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding LookupCommand}" Content="Look up" />
                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ToolTip="M31, NGC 7000, Sh2-129, or any name the catalog knows" />
                        </DockPanel>
                        <TextBlock Margin="0,2,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap" Text="{Binding FoundText}" Visibility="{Binding FoundText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="RA" />
                            <TextBox Grid.Column="1" Text="{Binding RaText, UpdateSourceTrigger=PropertyChanged}" ToolTip="00:42:44, or hours" />
                            <TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="Dec" />
                            <TextBox Grid.Column="3" Text="{Binding DecText, UpdateSourceTrigger=PropertyChanged}" ToolTip="+41:16:09, or degrees" />
                        </Grid>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock VerticalAlignment="Center" Text="Shape" />
                            <ComboBox
                                Margin="8,0,0,0"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding ShapeChoices}"
                                SelectedValue="{Binding Shape, Mode=TwoWay}"
                                SelectedValuePath="Code" />
                        </DockPanel>
                        <TextBlock Margin="0,2,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap" Text="{Binding SizeHint}" />
                        <Grid Margin="0,4,0,0" Visibility="{Binding Mosaic, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Width °" />
                            <TextBox Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="Height °" />
                            <TextBox Grid.Column="3" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <DockPanel Margin="0,10,0,2">
                            <Button DockPanel.Dock="Right" Padding="8,1" Command="{Binding AddFilterCommand}" Content="Add a filter" />
                            <TextBlock VerticalAlignment="Center" Text="Filters wanted" />
                        </DockPanel>
                        <!--  Colour cameras: their data is its own band, kept apart from the mono channels, and taken only when asked for.  -->
                        <!--  N.I.N.A.'s theme draws a CheckBox as a bare switch and drops its Content, so every switch gets its label beside it.  -->
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding AcceptOscRgb}" ToolTip="A colour camera behind a clear or UV/IR cut filter: red, green and blue on one matrix, logged as OSC-RGB" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Take OSC broadband (OSC-RGB)" />
                            <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding AcceptOscNarrowband}" ToolTip="A colour camera behind a dual-band filter: Ha and OIII on one matrix, logged as OSC-Ha+OIII" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Take OSC narrowband (OSC-Ha+OIII)" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Opacity="0.7" FontSize="11" Text="filter" />
                            <TextBlock Grid.Column="1" Opacity="0.7" FontSize="11" Text="hours wanted" ToolTip="Depth wanted at every point of the field. Blank: shoot it, no goal." />
                            <TextBlock Grid.Column="2" Opacity="0.7" FontSize="11" Text="bandpass ≤ nm" ToolTip="Blank takes any filter by that name; 7 keeps a 12 nm Ha out." />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Filters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Bandpass, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="3"
                                            Padding="6,0"
                                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="×" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Margin="0,8,0,0" Header="Rules (all optional)">
                            <Grid Margin="4,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Focal length mm" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MinFocal, UpdateSourceTrigger=PropertyChanged}" ToolTip="shortest allowed" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,6,2" VerticalAlignment="Center" Text="to" />
                                <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,2" Text="{Binding MaxFocal, UpdateSourceTrigger=PropertyChanged}" ToolTip="longest allowed" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Exposure s" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MinExposure, UpdateSourceTrigger=PropertyChanged}" ToolTip="shortest sub" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,6,2" VerticalAlignment="Center" Text="to" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,2" Text="{Binding MaxExposure, UpdateSourceTrigger=PropertyChanged}" ToolTip="longest sub" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Stars ≤ ″" ToolTip="Star size (HFR) a sub may have, in arcseconds; worse subs are not credited" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MaxHfr, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,6,2" VerticalAlignment="Center" Text="Guiding ≤ ″" />
                                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,2" Text="{Binding MaxGuideRms, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Moon ≤ %" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MaxMoon, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,6,2" VerticalAlignment="Center" Text="Moon ≥ ° away" />
                                <TextBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,2" Text="{Binding MinMoonSeparation, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Altitude ≥ °" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MinAltitude, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,0,6,2" VerticalAlignment="Center" Text="Frames per visit ≥" />
                                <TextBox Grid.Row="4" Grid.Column="3" Margin="0,0,0,2" Text="{Binding MinFrames, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,6,2" VerticalAlignment="Center" Text="Sky ≤ Bortle" ToolTip="1 is the darkest sky, 9 an inner city; a rig that has not rated its sky is told, not refused" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,2" Text="{Binding MaxBortle, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,4,0,0" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding RequireCalibrated}" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Calibrated frames only" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <TextBlock Margin="0,8,0,2" Text="Notes for the people joining" />
                        <TextBox AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding CollectFiles}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Collect the lights on the server" ToolTip="Everyone on it sends their lights, flats, darks and bias to the server's files page, sorted by collaboration and person, for you to stack. Off, the ledger records what was shot and the files stay with whoever shot them." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowJoinCode, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                            <TextBlock Margin="0,8,0,2" Text="Rapid Stacker Collab join code (pasted before; kept)" />
                            <TextBox
                                Text="{Binding StackingJoinCode, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="The code this collaboration was given before Starfront made stacking projects itself. It keeps working; clear it to stop stacking there. A different code is refused." />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap" Text="Live stacking follows the collaboration: Starfront stacks it on your hub, or makes and keeps the Rapid Stacker Collab project itself once your Collab account is linked. Turn it off or choose another in Starfront's Collab tab." />

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Padding="12,3" Command="{Binding StartCommand}" Content="{Binding SubmitLabel}" />
                            <Button Margin="8,0,0,0" Padding="10,3" Command="{Binding CancelCommand}" Content="Clear" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    </StackPanel>
                </Expander>

                <!--  The list: made to be searched through at hundreds. One compact line per
                      collaboration, sorted by what matters, filtered by a word and two
                      switches; a line opens into the full card, and the sky pictures are
                      fetched only for cards that are open. The list scrolls on its own,
                      virtualised, so a thousand rows cost what the visible dozen do.  -->
                <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Collaborations" />
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,1" Command="{Binding ClearSearchCommand}" Content="×" ToolTip="Clear the search" Visibility="{Binding Search, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Search: a word from the name, the coordinator, the notes, a filter or a participant" />
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding ShownText}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="Show" />
                    <ComboBox
                        Width="150"
                        Margin="6,0,0,0"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding ShowChoices}"
                        SelectedValue="{Binding Show, Mode=TwoWay}"
                        SelectedValuePath="Code" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="Sort" />
                    <ComboBox
                        Width="120"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding SortChoices}"
                        SelectedValue="{Binding SortBy, Mode=TwoWay}"
                        SelectedValuePath="Code" />
                </DockPanel>
                <TextBlock Opacity="0.7" Text="{Binding EmptyText}" Visibility="{Binding EmptyText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                <ListBox
                    MaxHeight="720"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding Projects}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="8,4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <!--  The compact line: everything a browser decides on, and a click to open it.  -->
                                    <Button
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ToggleCommand}"
                                        Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Top" Opacity="0.7" Text="{Binding Chevron}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Margin="6,0,0,0" Opacity="0.7" Text="{Binding Coordinator}" />
                                                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#7EE7A5" Text="joined" Visibility="{Binding Joined, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                                </StackPanel>
                                                <TextBlock Opacity="0.85" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" FontSize="11" FontWeight="SemiBold" Foreground="#7EE7A5" Text="✓ can take part" Visibility="{Binding FitOk, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" FontSize="11" FontWeight="SemiBold" Foreground="#F0A070" Text="✗ cannot" Visibility="{Binding FitOk, Converter={StaticResource Starfront_Dock_ShowWhenFalse}}" />
                                        </Grid>
                                    </Button>
                                    <!--  The card, open.  -->
                                    <StackPanel Margin="18,4,0,0" Visibility="{Binding Expanded, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                                    <TextBlock Opacity="0.85" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <!--  The sky, with the region outlined and this telescope's panels on it.  -->
                                    <Border
                                        Width="320"
                                        Height="200"
                                        Margin="0,6,0,2"
                                        HorizontalAlignment="Left"
                                        Background="Black"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding Framing}" Stretch="Uniform" Visibility="{Binding HasFraming, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.7"
                                                Text="{Binding FramingNote}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding FramingNote, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Opacity="0.6" FontSize="11" Text="{Binding FramingCaption}" Visibility="{Binding FramingCaption, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                                    <!--  How well placed it is tonight: altitude through the dark, transit marked.  -->
                                    <Border
                                        Width="320"
                                        Height="90"
                                        Margin="0,6,0,2"
                                        HorizontalAlignment="Left"
                                        Background="Black"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasTransit, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                                        <Image Source="{Binding Transit}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Opacity="0.6" FontSize="11" Text="{Binding TransitText}" TextWrapping="Wrap" Visibility="{Binding TransitText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                                    <!--  Depth per channel against the goal, the total, and whether this telescope can help: the three things somebody browsing wants to know.  -->
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding FilterProgress}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Maximum="100" Minimum="0" Value="{Binding Percent, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.85" Text="{Binding Text}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Opacity="0.9" Text="{Binding ProgressText}" />
                                    <!--  Whether this telescope can help, and the buttons: before the list of who is on it, which can be long.  -->
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="#7EE7A5"
                                        Text="{Binding FitText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding FitOk, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="#F0A070"
                                        Text="{Binding FitText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding FitOk, Converter={StaticResource Starfront_Dock_ShowWhenFalse}}" />
                                    <TextBlock Text="{Binding TonightText}" TextWrapping="Wrap" Visibility="{Binding TonightText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                                    <!--  Where the lights go, when the collaboration collects them.  -->
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding FilesText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}">
                                        <TextBlock VerticalAlignment="Center" Opacity="0.85" Text="{Binding FilesText}" TextWrapping="Wrap" />
                                        <Button Margin="8,0,0,0" Padding="8,1" VerticalAlignment="Center" Command="{Binding OpenFilesCommand}" Content="Open the files page" />
                                    </StackPanel>
                                    <!--  Whether the lights are stacked as they land, and how this telescope stands with that stack.  -->
                                    <TextBlock Margin="0,4,0,0" Opacity="0.85" Text="{Binding StackingText}" TextWrapping="Wrap" Visibility="{Binding StackingText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Button
                                            Padding="10,2"
                                            Command="{Binding JoinCommand}"
                                            Content="Join"
                                            Visibility="{Binding Joined, Converter={StaticResource Starfront_Dock_ShowWhenFalse}}" />
                                        <Button
                                            Padding="10,2"
                                            Command="{Binding LeaveCommand}"
                                            Content="Leave"
                                            Visibility="{Binding Joined, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                        <Button
                                            Margin="8,0,0,0"
                                            Padding="10,2"
                                            Command="{Binding ShowInFramingCommand}"
                                            Content="Show in Framing Assistant" />
                                    </StackPanel>
                                    <!--  Yours: change it, take it off the list, or have everybody dealt afresh.  -->
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding Mine, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}">
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.7" FontSize="11" Text="Yours:" />
                                        <Button Padding="8,1" Command="{Binding EditCommand}" Content="Edit" />
                                        <Button Margin="6,0,0,0" Padding="8,1" Command="{Binding RedealCommand}" Content="Deal again" ToolTip="Every telescope on it is dealt afresh at its next check-in" />
                                        <Button Margin="6,0,0,0" Padding="8,1" Command="{Binding CloseCommand}" Content="Close" ToolTip="Off everybody's list; what was collected stays on record" />
                                    </StackPanel>
                                    <!--  Who is on it: a name per line, the ones online marked, with what they are doing.  -->
                                    <TextBlock Margin="0,6,0,0" Opacity="0.7" Text="{Binding PeopleText}" />
                                    <ItemsControl Margin="8,0,0,0" ItemsSource="{Binding Participants}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="12" Foreground="#7EE7A5" Text="●" Visibility="{Binding Online, Converter={StaticResource Starfront_Dock_ShowWhenTrue}}" />
                                                    <TextBlock Width="12" Opacity="0.35" Text="○" Visibility="{Binding Online, Converter={StaticResource Starfront_Dock_ShowWhenFalse}}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Margin="8,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding Doing}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Everybody online, as a table, the shooting ones first; folded away until wanted.  -->
                <Expander Margin="0,12,0,0" IsExpanded="{Binding TelescopesOpen, Mode=TwoWay}" Visibility="{Binding TelescopesText, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Text="{Binding TelescopesText}" />
                    </Expander.Header>
                <Grid Margin="4,4,0,0" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="scopeName" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="scopeOwner" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="scopeDoing" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,12,0" Opacity="0.6" FontSize="11" Text="Telescope" />
                        <TextBlock Grid.Column="1" Margin="0,0,12,0" Opacity="0.6" FontSize="11" Text="Owner" />
                        <TextBlock Grid.Column="2" Margin="0,0,12,0" Opacity="0.6" FontSize="11" Text="Doing" />
                        <TextBlock Grid.Column="3" Opacity="0.6" FontSize="11" Text="Target · collaboration" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Telescopes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="scopeName" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="scopeOwner" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="scopeDoing" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,12,0" Opacity="0.85" Text="{Binding Owner}" />
                                    <TextBlock Grid.Column="2" Margin="0,0,12,0" Opacity="0.85" Text="{Binding Doing}" />
                                    <TextBlock Grid.Column="3" Opacity="0.85" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Target, Mode=OneWay}" /><Run Text=" " /><Run Foreground="#7EE7A5" Text="{Binding Project, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Expander>

                <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Frames reported" Visibility="{Binding Verdicts, Converter={StaticResource Starfront_Dock_ShowWhenSomething}}" />
                <ItemsControl ItemsSource="{Binding Verdicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
