<Project Sdk="Microsoft.NET.Sdk">
  <!-- The collaboration plugin's upload queue against an in-memory server.
       Nothing here starts N.I.N.A. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);NU1701;CS1591;xUnit1013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Starfront.Collab/Starfront.Collab.csproj" />
  </ItemGroup>
</Project>
