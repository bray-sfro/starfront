+        # not aim twenty-three hours the other way.
+        delta_ra = ((result.ra - target_ra + 12.0) % 24.0) - 12.0
+        delta_dec = result.dec - target_dec
+        aim_ra = astro.normalise_ra_hours(target_ra - delta_ra)
