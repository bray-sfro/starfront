+            f"by RA {-east:+.2f}', Dec {-north:+.2f}'")
+        self._set("correcting",
+                  f"{result.separation:.2f}' out — slewing by the pointing offset")
+        mount.slew_to(aim_ra, aim_dec)
+        self._wait_for_slew(mount)
+        return commanded
