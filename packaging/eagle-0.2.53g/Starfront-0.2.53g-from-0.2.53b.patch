diff -ruN --exclude __pycache__ --exclude '*.pyc' sf-0.2.53b/tools/check_calib_roof_closed.py b/tools/check_calib_roof_closed.py
--- a/tools/check_calib_roof_closed.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/check_calib_roof_closed.py	2026-11-09 18:19:51.703191835 +0000
@@ -0,0 +1,331 @@
+"""Darks, bias and panel flats never open the roof (0.2.53g).
+
+A mock dome records every command. The runs are the real CalibrationRunner:
+bias, dark, panel flats, and an autocal recipe of all three (what the
+Calibrate tab offers as a full library). Sky flats are not in that set.
+
+    python tools/check_calib_roof_closed.py
+
+Enforced in:
+
+* astrocontrol/roofguard.py
+    needs_closed_roof, begin/end, blocked, request_open
+* astrocontrol/calibrating.py
+    CalibrationRunner._set_on_rig, _shoot_set, _require_roof_closed,
+    _require_cover_closed, _one_filter
+* astrocontrol/main.py
+    dome_shutter — refuses an open while a closed-roof run is active
+* astrocontrol/sequencer.py
+    Sequencer._ensure_roof_open — goes through request_open
+* astrocontrol/devices/ascom.py AscomDome.open_shutter
+* astrocontrol/devices/alpaca.py AlpacaDome.open_shutter
+    both raise before the driver is asked
+"""
+
+from __future__ import annotations
+
+import inspect
+import os
+import sys
+import tempfile
+import threading
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("ASTRO_DATA_DIR", tempfile.mkdtemp(prefix="calib-roof-"))
+
+from astrocontrol.calibrating import CalibrationRunner          # noqa: E402
+from astrocontrol.config import Config                            # noqa: E402
+from astrocontrol.devices.base import DeviceError                 # noqa: E402
+from astrocontrol.main import dome_shutter                        # noqa: E402
+from astrocontrol import roofguard                                # noqa: E402
+from astrocontrol.sequencer import Sequencer                      # noqa: E402
+
+results: list[bool] = []
+
+
+def case(name, ok, detail=""):
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""))
+    results.append(bool(ok))
+
+
+class Dome:
+    def __init__(self, state="closed"):
+        self.connected = True
+        self.can_shutter = True
+        self.name = "ASCOM.HakosRoof.Dome"
+        self.state = state
+        self.commands: list[str] = []
+        self.reads = 0
+
+    @property
+    def shutter_state(self):
+        self.reads += 1
+        if self.state == "closing" and self.reads > 1:
+            self.state = "closed"
+        return self.state
+
+    def open_shutter(self):
+        self.commands.append("open")
+        self.state = "opening"
+
+    def close_shutter(self):
+        self.commands.append("close")
+        self.state = "closed"
+
+
+class Panel:
+    connected = True
+    has_cover = True
+    max_brightness = 100
+
+    def __init__(self, cover="closed"):
+        self.cover_state = cover
+        self.light_on = False
+        self.brightness = 0
+        self.commands: list[str] = []
+
+    def turn_on(self, brightness):
+        self.commands.append(f"on({brightness})")
+        self.light_on = self.cover_state == "closed"
+        self.brightness = brightness
+
+    def turn_off(self):
+        self.commands.append("off")
+        self.light_on = False
+
+    def open_cover(self):
+        self.commands.append("open-cover")
+        self.cover_state = "open"
+
+    def close_cover(self):
+        self.commands.append("close-cover")
+        self.cover_state = "closed"
+
+
+class Camera:
+    connected = True
+    gain = 100
+    offset = 50
+    name = "ZWO ASI6200MM Pro"
+    temperature = -10.0
+    sensor_width = 0
+    sensor_height = 0
+
+    def set_settings(self, **_kw):
+        pass
+
+
+class Capture:
+    def __init__(self, dome: Dome, refuse_open: bool):
+        self.dome = dome
+        self.refuse_open = refuse_open
+        self.exposures: list[tuple] = []
+        self.save_enabled = True
+        self.calibration_context = ""
+        self.open_requests: list[str] = []
+
+    def night_name(self):
+        return "2026-11-09"
+
+    def set_output(self, **_kw):
+        pass
+
+    def snapshot_output(self):
+        return {}
+
+    def restore_output(self, _saved):
+        pass
+
+    def capture_blocking(self, exposure, frame_type="light"):
+        if self.refuse_open:
+            try:
+                roofguard.request_open(self.dome)
+                self.open_requests.append("sent")
+            except DeviceError as exc:
+                self.open_requests.append(f"refused: {exc}")
+        self.exposures.append((frame_type, float(exposure)))
+
+        class Record:
+            path = "frame.fits"
+            ccd_temperature = -10.0
+            width = 4
+            height = 4
+            stats = {"median": 25000.0, "saturatedPercent": 0.0, "max": 25000}
+
+        return Record()
+
+
+class Manager:
+    def __init__(self, devices):
+        self.devices = devices
+
+    def get(self, kind):
+        return self.devices.get(kind)
+
+    def require(self, kind):
+        device = self.devices.get(kind)
+        if device is None:
+            raise DeviceError(f"{kind} not connected")
+        return device
+
+
+class Rig:
+    def __init__(self, devices):
+        self.id = "main"
+        self.name = "FSQ85"
+        self.manager = Manager(devices)
+        self.capture = devices["capture"]
+
+
+class Rigs:
+    def __init__(self, rig):
+        self.master = rig
+        self.all = [rig]
+        self.messages = []
+
+    def log(self, message, level="info"):
+        self.messages.append((level, message))
+
+    def imaging(self):
+        return [self.master]
+
+    def get(self, rid):
+        return self.master if rid in (None, self.master.id) else None
+
+
+class Library:
+    root = Path(tempfile.mkdtemp(prefix="calib-lib-"))
+
+    def settings(self):
+        return {}
+
+    def sub_folder(self, *_a, **_k):
+        folder = self.root / "subs"
+        folder.mkdir(parents=True, exist_ok=True)
+        return folder
+
+    def match(self, *_a, **_k):
+        return None, "none"
+
+    def forget(self):
+        pass
+
+    def frame(self, *_a, **_k):
+        return None
+
+
+def runner(dome, panel, refuse_open=False):
+    capture = Capture(dome, refuse_open)
+    rig = Rig({"camera": Camera(), "dome": dome, "flatpanel": panel, "capture": capture})
+    rig.capture = capture
+    config = Config(Path(tempfile.mkdtemp(prefix="calib-cfg-")) / "settings.json")
+    made = CalibrationRunner(Rigs(rig), config, Library())
+    made._build = lambda job, stopped, note: {
+        "telescope": rig.name, "rig": rig.id, "set": job["label"],
+        "frameType": job["kind"], "master": {"path": "master.fits"},
+        "info": {"frames": 1, "method": "test"},
+        "exposure": job["exposure"], "measuredAdu": job.get("measured"),
+    }
+    return made, capture
+
+
+def recipe(kinds):
+    sets = []
+    for kind in kinds:
+        row = {"frameType": kind, "count": 1, "exposure": 1.0, "binning": 1}
+        if kind == "flat":
+            row["source"] = "panel"
+            row["filter"] = ""
+        sets.append(row)
+    return {"name": "autocal" if len(kinds) > 1 else kinds[0], "sets": sets}
+
+
+def run(kinds, state="closed", refuse_open=False, cover="closed"):
+    dome = Dome(state)
+    panel = Panel(cover)
+    made, capture = runner(dome, panel, refuse_open=refuse_open)
+    made.run(recipe(kinds))
+    return dome, capture, made
+
+
+print("\n-- closed roof, no open command --")
+
+for kinds, label in (
+    (["bias"], "bias"),
+    (["dark"], "dark"),
+    (["flat"], "panel flats"),
+    (["bias", "dark", "flat"], "autocal (bias, dark, panel flats)"),
+):
+    dome, capture, _made = run(kinds, refuse_open=True)
+    case(f"{label}: zero open commands",
+         dome.commands.count("open") == 0, str(dome.commands))
+    case(f"{label}: frames were taken under a closed roof",
+         any(kind in ("bias", "dark", "flat") for kind, _e in capture.exposures),
+         str(capture.exposures))
+    case(f"{label}: an open request during the run was refused",
+         capture.open_requests and all(item.startswith("refused") for item in capture.open_requests),
+         str(capture.open_requests))
+    case("the guard is down after the run", roofguard.blocked() is None)
+
+print("\n-- a roof that reads open aborts the frames --")
+
+dome, capture, made = run(["dark"], state="open")
+case("no dark was taken while the roof read open", capture.exposures == [],
+     str(capture.exposures))
+case("still no open command", "open" not in dome.commands, str(dome.commands))
+case("the run says why",
+     any("roof" in message.lower() for _level, message in made.rigs.messages),
+     str(made.rigs.messages[-3:]))
+
+print("\n-- a roof that is closing is held, then the frames go --")
+
+dome, capture, _made = run(["bias"], state="closing")
+case("bias waited until the roof read closed", capture.exposures != [],
+     str(capture.exposures))
+case("holding did not open it", "open" not in dome.commands, str(dome.commands))
+
+print("\n-- the cover, where there is one --")
+
+dome, capture, made = run(["dark"], cover="open")
+# The run closes the cover itself before the frames. That is the existing
+# dark path. If it is closed by then, frames proceed and the roof stays shut.
+case("the cover is closed for the darks",
+     made.rigs.master.manager.get("flatpanel").cover_state == "closed")
+case("the roof was not opened to close the cover", "open" not in dome.commands)
+
+print("\n-- sky flats are not under the closed-roof rule --")
+
+case("a sky flat may open",
+     not roofguard.needs_closed_roof({"frameType": "flat", "source": "sky"}))
+case("a panel flat may not",
+     roofguard.needs_closed_roof({"frameType": "flat", "source": "panel"}))
+case("a bias may not", roofguard.needs_closed_roof({"frameType": "bias"}))
+case("a dark may not", roofguard.needs_closed_roof({"frameType": "dark"}))
+case("a dark flat may not", roofguard.needs_closed_roof({"frameType": "darkflat"}))
+
+print("\n-- where an open is refused --")
+
+src_seq = inspect.getsource(Sequencer._ensure_roof_open)
+src_api = inspect.getsource(dome_shutter)
+src_set = inspect.getsource(CalibrationRunner._set_on_rig)
+case("the sequencer opens through request_open", "roofguard.request_open" in src_seq)
+case("the sequencer does not call open_shutter itself", "open_shutter" not in src_seq)
+case("the roof button checks the guard before opening", "roofguard.blocked" in src_api)
+case("a closed-roof set holds the guard", "roofguard.begin" in src_set)
+
+# The guard refuses even with no runner, which is what the button and the
+# sequencer both hit.
+with roofguard.closed_for("bias"):
+    lone = Dome()
+    try:
+        roofguard.request_open(lone)
+        case("request_open during a closed-roof run raises", False)
+    except DeviceError:
+        case("request_open during a closed-roof run raises", True)
+    case("and the dome recorded nothing", lone.commands == [], str(lone.commands))
+
+failed = len(results) - sum(results)
+print(f"\n{sum(results)}/{len(results)} passed")
+sys.exit(1 if failed else 0)
diff -ruN --exclude __pycache__ --exclude '*.pyc' sf-0.2.53b/tools/check_filter_settle.py b/tools/check_filter_settle.py
--- a/tools/check_filter_settle.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/check_filter_settle.py	2026-11-09 18:19:25.879185856 +0000
@@ -0,0 +1,188 @@
+"""Lights are not taken on an unknown filter (0.2.53g).
+
+The ZWO EFW reports position -1 ("moving") from a poll that overlaps its
+own status, and on this rig that read stays -1 the whole night. A later
+read that is a real slot is that slot. All -1 is not a filter: the run
+holds, and FILTER is not guessed. A colour camera with no wheel is
+OSC-RGB, including when the drawer says L.
+
+    python tools/check_filter_settle.py
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("ASTRO_DATA_DIR", tempfile.mkdtemp(prefix="filter-settle-"))
+
+from astrocontrol.capture import CaptureService                 # noqa: E402
+from astrocontrol.config import Config                            # noqa: E402
+from astrocontrol.devices.base import DeviceError, FilterWheel, read_slot  # noqa: E402
+from astrocontrol.sequencer import Sequencer                      # noqa: E402
+
+results: list[bool] = []
+
+
+def case(name, ok, detail=""):
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""))
+    results.append(bool(ok))
+
+
+class StuckWheel:
+    """Position -1 on every read. The driver never names a slot."""
+
+    connected = True
+    names = ["L", "R", "G", "B", "S", "H", "O"]
+
+    def __init__(self):
+        self.commands = []
+
+    @property
+    def position(self):
+        return -1
+
+    @property
+    def moving(self):
+        return True
+
+    def set_position(self, index):
+        self.commands.append(index)
+
+
+class ScriptedWheel(FilterWheel):
+    """Hands back a scripted series of position reads."""
+
+    def __init__(self, reads):
+        super().__init__("fake", "EFW")
+        self._connected = True
+        self._reads = list(reads)
+        self._slot_names = ["L", "R", "G", "B", "S", "H", "O"]
+        self.commands = []
+
+    @property
+    def names(self):
+        return list(self._slot_names)
+
+    @property
+    def position(self):
+        if self._reads:
+            return self._reads.pop(0)
+        return -1
+
+    def set_position(self, index):
+        self.commands.append(index)
+
+
+class ColourCamera:
+    connected = True
+    bayer_pattern = "RGGB"
+    name = "ZWO ASI6200MC Pro"
+
+
+class MonoCamera:
+    connected = True
+    bayer_pattern = None
+    name = "ZWO ASI6200MM Pro"
+
+
+class Manager:
+    def __init__(self, devices):
+        self.devices = devices
+        self.logs = []
+
+    def get(self, kind):
+        return self.devices.get(kind)
+
+    def log(self, message, level="info"):
+        self.logs.append((level, message))
+
+
+def service(devices, **camera):
+    config = Config(Path(tempfile.mkdtemp(prefix="filt-cfg-")) / "settings.json")
+    if camera:
+        config.update("camera", camera)
+    capture = CaptureService(Manager(devices), config)
+    return capture
+
+
+print("\n-- a wheel that only says moving --")
+
+always = ScriptedWheel([-1, -1, -1])
+slot, moving = read_slot(always)
+case("three -1 reads are not a slot", slot is None and moving)
+
+stuck = StuckWheel()
+
+cap = service({"filterwheel": stuck, "camera": MonoCamera()})
+try:
+    cap._light_filter()
+    case("a light is refused when the wheel has not settled", False)
+except DeviceError as exc:
+    case("a light is refused when the wheel has not settled",
+         "not guessed" in str(exc), str(exc))
+
+print("\n-- moving, but a position read is valid --")
+
+glitch = ScriptedWheel([-1, -1, 0])
+slot, said = read_slot(glitch)
+case("a later valid read is the slot", slot == 0 and said, f"slot={slot} moving={said}")
+
+cap = service({"filterwheel": ScriptedWheel([-1, 0, 0]), "camera": MonoCamera()})
+name = cap._light_filter()
+case("the light is tagged with that slot, not a blank", name == "L", name)
+case("the moving flag was noticed",
+     any("reported moving" in message for _level, message in cap.manager.logs))
+
+print("\n-- the sequencer holds instead of exposing --")
+
+
+class Rig:
+    def __init__(self, wheel):
+        self.id = "main"
+        self.name = "FSQ85"
+        self.role = "master"
+        self.manager = Manager({"filterwheel": wheel})
+        self.config = Config(Path(tempfile.mkdtemp(prefix="seq-cfg-")) / "settings.json")
+
+
+class Rigs:
+    def __init__(self, rig):
+        self.master = rig
+        self.all = [rig]
+
+    def imaging(self):
+        return [self.master]
+
+
+config = Config(Path(tempfile.mkdtemp(prefix="seq2-")) / "settings.json")
+seq = Sequencer(Rigs(Rig(stuck)), config, None, None)
+seq.FILTER_SETTLE_SECONDS = 0.3
+seq.warnings = None
+try:
+    seq._select_filter(seq.rigs.master, "H")
+    case("an unsettled wheel raises before the exposure", False)
+except DeviceError as exc:
+    case("an unsettled wheel raises before the exposure", "did not settle" in str(exc),
+         str(exc)[:80])
+
+print("\n-- a colour camera with no wheel is OSC-RGB --")
+
+colour = service({"camera": ColourCamera()}, fixedFilter="L", colour=True)
+case("OSC-RGB, not the drawer's L", colour._light_filter() == "OSC-RGB",
+     colour._light_filter())
+
+mono = service({"camera": MonoCamera()}, fixedFilter="L")
+case("a mono camera with no wheel keeps the filter that is fitted",
+     mono._light_filter() == "L")
+
+kept = service({"camera": ColourCamera()}, fixedFilter="OSC-Ha+OIII", colour=True)
+case("an OSC name already set is kept", kept._light_filter() == "OSC-Ha+OIII")
+
+failed = len(results) - sum(results)
+print(f"\n{sum(results)}/{len(results)} passed")
+sys.exit(1 if failed else 0)
diff -ruN --exclude __pycache__ --exclude '*.pyc' sf-0.2.53b/tools/check_follower_quiet.py b/tools/check_follower_quiet.py
--- a/tools/check_follower_quiet.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/check_follower_quiet.py	2026-11-09 18:37:15.923020947 +0000
@@ -0,0 +1,139 @@
+"""The Rokinon never uploads and never adds to the collaboration hours (0.2.53g).
+
+Its L subs were reported under the FSQ85 agent and counted toward the
+project. A follower frame is not queued, not sent, and not included in the
+session report. A report that is sent names the camera and that camera's
+focal length.
+
+    python tools/check_follower_quiet.py
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("ASTRO_DATA_DIR", tempfile.mkdtemp(prefix="follower-quiet-"))
+
+from astrocontrol.autoupload import AutoUploader                    # noqa: E402
+from astrocontrol.collabclient import CollabClient                  # noqa: E402
+from astrocontrol.config import Config                              # noqa: E402
+from astrocontrol.targets import TargetStore                        # noqa: E402
+
+results: list[bool] = []
+
+
+def case(name, ok, detail=""):
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""))
+    results.append(bool(ok))
+
+
+class Conf:
+    def __init__(self):
+        from astrocontrol.config import DEFAULTS
+        self.data = dict(DEFAULTS["collab"])
+
+    def section(self, name):
+        return dict(self.data) if name == "collab" else {}
+
+
+FOLLOWER = {"role": "follower", "camera": "ZWO ASI6200MC Pro", "bayer": "RGGB",
+            "colour": True, "mono": False, "upload": None, "name": "Rokinon 135mm"}
+MASTER = {"role": "master", "camera": "ZWO ASI6200MM Pro", "colour": False,
+          "mono": True, "upload": None, "name": "FSQ85"}
+
+tmp = Path(tempfile.mkdtemp(prefix="fq-"))
+up = AutoUploader(Conf(), SimpleNamespace(_ready=lambda: None), folder=tmp / "q")
+light = tmp / "rokinon.fits"
+light.write_bytes(b"not-a-real-upload")
+queued = up.light_saved(str(light), {"collabProject": "97fcae827a9f",
+                                    "collabTask": "481536614589"},
+                        "Rokinon 135mm", None, identity=FOLLOWER)
+case("a follower light is not queued", queued is False and up.items == [])
+up.add(light, "97fcae827a9f", "light", "481536614589", "Rokinon 135mm",
+       identity=FOLLOWER)
+calls = []
+up.http = lambda method, path, body: calls.append((method, path)) or (200, {"already": True}, {})
+up.send(up.items[0])
+case("a follower light is not sent",
+     up.items[0]["state"] == "refused" and calls == [],
+     f"state={up.items[0]['state']} calls={calls}")
+
+# Session report. 12.25 h of Rokinon L must not be posted. The FSQ85's own
+# 300 s is posted, with that camera's name and focal length.
+config = Config(tmp / "settings.json")
+config.update("optics", {"focalLength": 450.0, "pixelSize": 3.76})
+config.update("camera", {"colour": False, "binning": 1})
+config.update("collab", {"enabled": True, "token": "rig-token"})
+
+
+class MasterRig:
+    config = config
+
+
+class Rigs:
+    master = MasterRig()
+
+
+store = TargetStore(tmp / "targets.json")
+target = store.create("m42 horse test mosaic", 5.588, -4.9, 0.0,
+                      collab={"project": "97fcae827a9f", "task": "481536614589",
+                              "projectName": "m42 horse test mosaic"})
+store.add_panel_integration(
+    target["id"], "2026-11-05", 20, "L", 300.0,
+    telescope="FSQ85", instrument="ZWO ASI6200MM Pro",
+    focal_length=455.0, role="master", colour=False)
+store.add_panel_integration(
+    target["id"], "2026-11-05", 20, "L", 12.25 * 3600.0,
+    telescope="Rokinon 135mm", instrument="ZWO ASI6200MC Pro",
+    focal_length=135.0, role="follower", colour=True, bayer="RGGB")
+
+posted = []
+
+
+def fake_call(method, path, body=None):
+    posted.append((method, path, body))
+    rows = (body or {}).get("contributions") or []
+    return {"recorded": [{"id": f"c{i}", "accepted": True, "verdict": {"summary": "ok"}}
+                         for i in range(len(rows))]}
+
+
+client = CollabClient(Rigs(), config, store)
+client._call = fake_call
+sent = client.report_pending()
+body = posted[0][2] if posted else {}
+rows = body.get("contributions") or []
+case("the follower produces no session report",
+     sent == 1 and len(rows) == 1 and rows[0]["seconds"] == 300.0
+     and rows[0]["filterName"] == "L",
+     f"sent={sent} rows={rows}")
+case("the Rokinon's 12.25 h is not in the report",
+     all(float(row.get("seconds") or 0) < 1000 for row in rows)
+     and not any("6200MC" in str(row.get("instrument") or "") for row in rows)
+     and not any("Rokinon" in str(row) for row in rows))
+case("the report names the camera and its focal length",
+     rows and rows[0].get("instrument") == "ZWO ASI6200MM Pro"
+     and rows[0].get("focalLength") == 455.0,
+     str(rows[0] if rows else None))
+case("a second poll sends nothing more", client.report_pending() == 0 and len(posted) == 1)
+
+# A tally with no camera identity (the older rows) is still reported.
+legacy = TargetStore(tmp / "legacy.json")
+old = legacy.create("Cygnus", 20.9, 44.6, collab={"project": "p", "task": "t"})
+legacy.add_panel_integration(old["id"], "2026-09-21", 1, "Ha", 600.0)
+legacy.add_panel_integration(old["id"], "2026-09-21", 1, "Ha", 600.0)
+posted.clear()
+other = CollabClient(Rigs(), config, legacy)
+other._call = fake_call
+case("a row that never recorded a camera is still reported",
+     other.report_pending() == 1 and posted[0][2]["contributions"][0]["frames"] == 2,
+     str(posted[0][2]["contributions"] if posted else None))
+
+failed = len(results) - sum(results)
+print(f"\n{sum(results)}/{len(results)} passed")
+sys.exit(1 if failed else 0)
diff -ruN --exclude __pycache__ --exclude '*.pyc' sf-0.2.53b/tools/check_mount_clock.py b/tools/check_mount_clock.py
--- a/tools/check_mount_clock.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/check_mount_clock.py	2026-11-09 18:13:39.133981903 +0000
@@ -0,0 +1,359 @@
+"""The mount clock against this PC. Read-only.
+
+    python3 tools/check_mount_clock.py
+
+A connected mount whose UTC or local sidereal time is more than a minute
+from this PC raises a warning on the board that status already publishes.
+A clock inside that minute does not. No mount, a mount that is
+disconnected, or a driver that does not answer is "clock check skipped".
+The driver is read once per connection. Nothing is synced or slewed.
+
+No test framework, for the same reason as the other checks here.
+"""
+import ast
+import os
+import sys
+import tempfile
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("ASTRO_DATA_DIR", tempfile.mkdtemp())
+
+from astrocontrol import __version__, astro, mountclock, warnings          # noqa: E402
+from astrocontrol.config import Config                                      # noqa: E402
+
+results = []
+
+
+def case(name, ok, detail=""):
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""))
+    results.append(bool(ok))
+    return ok
+
+
+NOW = datetime(2026, 11, 6, 6, 0, tzinfo=timezone.utc)
+mountclock.clock = lambda: NOW
+
+WRITES = ("sync_to", "slew_to", "set_tracking", "park", "unpark", "abort_slew")
+
+
+def pc_lst(longitude=0.0):
+    return astro.local_sidereal_hours(longitude, NOW)
+
+
+class Manager:
+    def __init__(self, devices):
+        self.devices = devices
+
+    def get(self, kind):
+        return self.devices.get(kind)
+
+
+class Rig:
+    def __init__(self, devices, name="FSQ106"):
+        self.id = name
+        self.name = name
+        self.manager = Manager(devices)
+
+
+class Rigs:
+    def __init__(self, rig, log):
+        self.master = rig
+        self.all = [rig]
+        self.log = log
+
+
+class ClockMount:
+    """A mount that reports a clock and records anything that would move it."""
+
+    def __init__(self, utc=None, lst=None, boom=False):
+        self.connected = True
+        self.tracking = True
+        self.slewing = False
+        self.site = {"latitude": 31.9, "longitude": 0.0, "elevation": 1000.0}
+        self.calls = []
+        self.utc = utc
+        self.lst = lst
+        self.boom = boom
+
+    def reported_clock(self):
+        self.calls.append("reported_clock")
+        if self.boom:
+            raise RuntimeError("driver busy")
+        return {"utc": self.utc, "lst": self.lst}
+
+    def sync_to(self, *args, **kwargs):
+        self.calls.append("sync_to")
+
+    def slew_to(self, *args, **kwargs):
+        self.calls.append("slew_to")
+
+    def set_tracking(self, *args, **kwargs):
+        self.calls.append("set_tracking")
+
+    def park(self, *args, **kwargs):
+        self.calls.append("park")
+
+    def unpark(self, *args, **kwargs):
+        self.calls.append("unpark")
+
+    def abort_slew(self, *args, **kwargs):
+        self.calls.append("abort_slew")
+
+
+def build(devices, longitude=0.0):
+    mountclock.reset()
+    config = Config(Path(tempfile.mkdtemp()) / "settings.json")
+    config.update("site", {"latitude": 31.9, "longitude": longitude, "useMount": True})
+    # A roomy disk, so the disk check stays quiet on this machine.
+    config.update("warnings", {"diskCriticalGb": 0.0, "diskWarnGb": 0.0})
+    logs = []
+    rig = Rig(devices)
+    board = warnings.WarningBoard(log=lambda message, level="info": logs.append((level, message)))
+    ctx = warnings.Context(
+        config=config, rigs=Rigs(rig, lambda message, level="info": logs.append((level, message))),
+        night=lambda: None)
+    dog = warnings.Watchdog(board, ctx, interval=999,
+                            log=lambda message, level="info": logs.append((level, message)))
+    return board, dog, logs
+
+
+def active(board):
+    return {item["key"]: item for item in board.snapshot()["active"]}
+
+
+def method_body(path, name):
+    lines = Path(path).read_text().splitlines()
+    start = next(index for index, line in enumerate(lines) if f"def {name}(" in line)
+    body = []
+    for line in lines[start + 1:]:
+        if line.startswith("    def ") or line.startswith("class "):
+            break
+        body.append(line)
+    return "\n".join(body)
+
+
+# ---------------------------------------------------------------- the wiring
+case("version is 0.2.53g", __version__ == "0.2.53g", __version__)
+case("the clock check is on the watchdog",
+     any(fn.__name__ == "mount_clock" for fn in warnings.CHECKS))
+main_text = (ROOT / "astrocontrol/main.py").read_text()
+case("status publishes the verdict without asking the mount again",
+     'payload["mountClock"] = mountclock.latest()' in main_text)
+
+ascom_body = method_body(ROOT / "astrocontrol/devices/ascom.py", "reported_clock")
+case("ASCOM clock read does not write",
+     "_set" not in ascom_body and "_invoke" not in ascom_body
+     and "setattr" not in ascom_body and "Sync" not in ascom_body
+     and "Slew" not in ascom_body and "UTCDate" in ascom_body
+     and "SiderealTime" in ascom_body)
+alpaca_body = method_body(ROOT / "astrocontrol/devices/alpaca.py", "reported_clock")
+case("Alpaca clock read is GET only",
+     ".put(" not in alpaca_body and "utcdate" in alpaca_body and "siderealtime" in alpaca_body)
+clock_source = (ROOT / "astrocontrol/mountclock.py").read_text()
+case("the comparison itself never commands the mount",
+     not any(name in clock_source for name in ("sync_to", "slew_to", "set_tracking", ".put(")))
+
+
+# ---------------------------------------------------------------- a real skew
+ahead = ClockMount(utc=NOW + timedelta(hours=2), lst=(pc_lst() + 2.0) % 24.0)
+board, dog, logs = build({"mount": ahead})
+dog.pass_once()
+found = active(board)
+warning = found.get("mount.clock")
+verdict = mountclock.latest()
+case("two hours fast is a warning",
+     warning is not None and warning["level"] == "warning"
+     and verdict["state"] == "warn"
+     and abs(verdict["utcDeltaSeconds"] - 7200) < 1
+     and abs(verdict["lstDeltaSeconds"] - 7200) < 1
+     and verdict["compared"] == ["utc", "lst"],
+     verdict["detail"])
+case("...and the warning names the shift and that nothing was changed",
+     warning is not None and "2h ahead of this PC" in warning["detail"]
+     and "30°" in warning["detail"] and "Nothing was changed." in warning["detail"]
+     and "will not sync" in warning["fix"])
+case("...and the mount was only read",
+     ahead.calls == ["reported_clock"] and not any(name in ahead.calls for name in WRITES))
+dog.pass_once()
+case("a second pass repeats the warning without reading again",
+     "mount.clock" in active(board) and ahead.calls == ["reported_clock"])
+case("the warning is on the board status publishes",
+     any(item["key"] == "mount.clock" for item in board.snapshot()["active"]))
+
+behind = ClockMount(utc=NOW - timedelta(hours=2))
+board, dog, logs = build({"mount": behind})
+dog.pass_once()
+text = active(board)["mount.clock"]["detail"]
+case("two hours slow says behind, and still only reads",
+     "2h behind this PC" in text and behind.calls == ["reported_clock"]
+     and mountclock.latest()["utcDeltaSeconds"] < 0)
+
+
+# ---------------------------------------------------------------- no skew
+matched = ClockMount(utc=NOW + timedelta(seconds=5), lst=(pc_lst() + 5 / 3600.0) % 24.0)
+board, dog, logs = build({"mount": matched})
+dog.pass_once()
+ok = mountclock.latest()
+case("five seconds is not a warning",
+     "mount.clock" not in active(board) and ok["state"] == "ok"
+     and abs(ok["utcDeltaSeconds"] - 5) < 1 and "matches this PC" in ok["detail"],
+     ok["detail"])
+case("...and the session log says so once",
+     sum(1 for level, message in logs if "matches this PC" in message) == 1)
+dog.pass_once()
+case("...and a second pass does not read or log it again",
+     matched.calls == ["reported_clock"]
+     and sum(1 for level, message in logs if "matches this PC" in message) == 1)
+
+on_the_minute = ClockMount(utc=NOW + timedelta(seconds=60))
+board, dog, _logs = build({"mount": on_the_minute})
+dog.pass_once()
+case("exactly one minute is still inside the limit",
+     mountclock.latest()["state"] == "ok" and "mount.clock" not in active(board))
+
+over = ClockMount(utc=NOW + timedelta(seconds=61))
+board, dog, _logs = build({"mount": over})
+dog.pass_once()
+case("a second past a minute is a warning",
+     "mount.clock" in active(board) and mountclock.latest()["state"] == "warn"
+     and "1m 01s ahead of this PC" in active(board)["mount.clock"]["detail"])
+
+
+# ---------------------------------------------------------------- skipped
+board, dog, logs = build({})
+dog.pass_once()
+skipped = mountclock.latest()
+case("no mount skips quietly",
+     skipped["state"] == "skipped" and skipped["detail"] == "clock check skipped"
+     and "mount.clock" not in active(board))
+case("...and says so in the log once",
+     sum(1 for _level, message in logs if message == "clock check skipped") == 1)
+
+asleep = ClockMount(utc=NOW + timedelta(hours=2))
+asleep.connected = False
+board, dog, _logs = build({"mount": asleep})
+dog.pass_once()
+case("a disconnected mount is a skip and is not asked",
+     mountclock.latest()["detail"] == "clock check skipped" and asleep.calls == []
+     and "mount.clock" not in active(board))
+
+broken = ClockMount(boom=True)
+board, dog, _logs = build({"mount": broken})
+dog.pass_once()
+silent = mountclock.latest()
+case("a driver that throws is a skip, not a crash",
+     silent["state"] == "skipped" and "did not report" in silent["detail"]
+     and "mount.clock" not in active(board) and broken.calls == ["reported_clock"])
+dog.pass_once()
+case("...and it is not asked again while it stays connected",
+     broken.calls == ["reported_clock"])
+
+mute = ClockMount(utc=None, lst=None)
+board, dog, _logs = build({"mount": mute})
+dog.pass_once()
+case("a connected mount with no time is a skip",
+     "did not report" in mountclock.latest()["detail"] and "mount.clock" not in active(board))
+
+
+# ---------------------------------------------------------------- sidereal time
+lst_only = ClockMount(utc=None, lst=(pc_lst() + 2.0) % 24.0)
+board, dog, _logs = build({"mount": lst_only})
+dog.pass_once()
+lst_warn = active(board)["mount.clock"]
+case("sidereal time two hours off warns when UTC is absent",
+     mountclock.latest()["compared"] == ["lst"]
+     and abs(mountclock.latest()["lstDeltaSeconds"] - 7200) < 1
+     and "local sidereal time" in lst_warn["detail"]
+     and "did not report UTC" in lst_warn["detail"]
+     and lst_only.calls == ["reported_clock"])
+
+lst_ok = ClockMount(utc=None, lst=pc_lst())
+board, dog, _logs = build({"mount": lst_ok})
+dog.pass_once()
+case("sidereal time that matches is not a warning",
+     mountclock.latest()["state"] == "ok" and "mount.clock" not in active(board))
+
+long_way = ClockMount(utc=None, lst=(pc_lst() + 23.0) % 24.0)
+board, dog, _logs = build({"mount": long_way})
+dog.pass_once()
+wrapped = mountclock.latest()
+case("twenty-three hours ahead is one hour behind, the short way",
+     wrapped["state"] == "warn" and wrapped["lstDeltaSeconds"] < 0
+     and abs(wrapped["lstDeltaSeconds"] + 3600) < 2
+     and "behind this PC" in active(board)["mount.clock"]["detail"],
+     str(wrapped["lstDeltaSeconds"]))
+
+utc_ok_lst_bad = ClockMount(utc=NOW + timedelta(seconds=3), lst=(pc_lst() + 2.0) % 24.0)
+board, dog, _logs = build({"mount": utc_ok_lst_bad})
+dog.pass_once()
+mixed = active(board)["mount.clock"]["detail"]
+case("a good UTC with a bad sidereal time still warns",
+     "local sidereal time" in mixed and "UTC agrees" in mixed
+     and mountclock.latest()["compared"] == ["utc", "lst"])
+
+no_longitude = ClockMount(utc=None, lst=(pc_lst() + 5.0) % 24.0)
+board, dog, _logs = build({"mount": no_longitude})
+# Site longitude removed: LST alone cannot be compared.
+dog.context.config.update("site", {"latitude": None, "longitude": None})
+# The mount's own site would still supply one. Clear it.
+no_longitude.site = None
+dog.pass_once()
+case("sidereal time with no longitude to compare is a skip",
+     mountclock.latest()["state"] == "skipped" and "mount.clock" not in active(board))
+
+
+# ---------------------------------------------------------------- what a driver might hand back
+iso = mountclock.assess({"utc": "2026-11-06T08:00:00Z", "lst": None},
+                        now=NOW, longitude=0.0)
+case("an ISO UTC two hours fast is the same warning",
+     iso["state"] == "warn" and abs(iso["utcDeltaSeconds"] - 7200) < 1)
+
+naive = mountclock.assess({"utc": datetime(2026, 11, 6, 8, 0), "lst": None},
+                          now=NOW, longitude=0.0)
+case("a naive datetime is taken as UTC",
+     naive["state"] == "warn" and abs(naive["utcDeltaSeconds"] - 7200) < 1)
+
+epoch = datetime(1899, 12, 30, tzinfo=timezone.utc)
+ole = (datetime(2026, 11, 6, 8, 0, tzinfo=timezone.utc) - epoch).total_seconds() / 86400.0
+from_ole = mountclock.assess({"utc": ole, "lst": None}, now=NOW, longitude=0.0)
+case("an OLE automation date is accepted",
+     from_ole["state"] == "warn" and abs(from_ole["utcDeltaSeconds"] - 7200) < 1)
+
+hours_as_date = mountclock.assess({"utc": 12.5, "lst": None}, now=NOW, longitude=None)
+case("a sidereal-sized number is not read as a calendar date",
+     hours_as_date["state"] == "skipped")
+
+
+# ---------------------------------------------------------------- reconnect
+fixed = ClockMount(utc=NOW + timedelta(hours=2))
+board, dog, _logs = build({"mount": fixed})
+dog.pass_once()
+case("the skew is on the board before anyone corrects it", "mount.clock" in active(board))
+fixed.connected = False
+dog.pass_once()
+case("disconnecting clears the warning and skips",
+     "mount.clock" not in active(board)
+     and mountclock.latest()["detail"] == "clock check skipped")
+fixed.connected = True
+fixed.utc = NOW + timedelta(seconds=1)
+dog.pass_once()
+case("reconnecting reads again, and a corrected clock is quiet",
+     fixed.calls.count("reported_clock") == 2
+     and "mount.clock" not in active(board)
+     and mountclock.latest()["state"] == "ok"
+     and not any(name in fixed.calls for name in WRITES))
+
+
+# The module parses. A syntax error in the drivers would still import, because
+# those bodies are only compiled with the file; this catches a broken tree.
+for relative in ("astrocontrol/mountclock.py", "astrocontrol/warnings.py",
+                 "astrocontrol/devices/base.py", "astrocontrol/devices/ascom.py",
+                 "astrocontrol/devices/alpaca.py", "astrocontrol/main.py"):
+    ast.parse((ROOT / relative).read_text())
+case("the touched files parse", True)
+
+print(f"\n{sum(results)}/{len(results)} passed")
+sys.exit(0 if all(results) else 1)
diff -ruN --exclude __pycache__ --exclude '*.pyc' sf-0.2.53b/tools/check_roof_status.py b/tools/check_roof_status.py
--- a/tools/check_roof_status.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/check_roof_status.py	2026-11-09 18:18:17.735263871 +0000
@@ -0,0 +1,62 @@
+"""The roof badge is a line, not a command (0.2.53g).
+
+    python tools/check_roof_status.py
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+
+ROOT = __import__("pathlib").Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("ASTRO_DATA_DIR", tempfile.mkdtemp(prefix="roof-status-"))
+
+from astrocontrol import roofstatus                            # noqa: E402
+
+results = []
+
+
+def case(name, ok, detail=""):
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""))
+    results.append(bool(ok))
+
+
+def line(state, locked="", now=100.0, connected=True):
+    roofstatus.reset()
+    dome = {"connected": connected, "canShutter": True, "shutterState": state}
+    return roofstatus.observe(dome, locked, now)
+
+
+opened = line("opening")
+later = roofstatus.observe(
+    {"connected": True, "canShutter": True, "shutterState": "opening"}, "", 112.4)
+case("opening names itself and the elapsed seconds",
+     later["text"].startswith("Roof opening…") and "12s" in later["text"], later["text"])
+
+case("then open", line("open")["text"] == "Roof open")
+roofstatus.reset()
+closing = roofstatus.observe(
+    {"connected": True, "canShutter": True, "shutterState": "closing"}, "", 50)
+closing = roofstatus.observe(
+    {"connected": True, "canShutter": True, "shutterState": "closing"}, "", 58)
+case("closing names itself and the elapsed seconds",
+     closing["text"].startswith("Roof closing…") and "8s" in closing["text"], closing["text"])
+case("then closed", line("closed")["text"] == "Roof closed")
+
+locked = line("closed", "not open after 180 s (it reads opening)")
+case("a timeout or technician lock is the text",
+     locked["text"].startswith("Roof locked:") and "180" in locked["text"], locked["text"])
+
+err = line("error")
+case("an error is the text", err["text"] == "Roof error", err["text"])
+
+case("no dome, no badge", line("open", connected=False)["connected"] is False)
+
+# Observing does not grow a command list. There is nothing to command.
+case("the helper has no open", not hasattr(roofstatus, "request_open"))
+
+failed = len(results) - sum(results)
+print(f"\n{sum(results)}/{len(results)} passed")
+raise SystemExit(1 if failed else 0)
