+# ---------------------------------------------------------------------------
+# What is in each telescope's light path
+# ---------------------------------------------------------------------------
+
+class TelescopeFiltersRequest(BaseModel):
+    #: telescope id -> the name of the filter fitted in it
+    filters: dict[str, str] = Field(default_factory=dict)
+
+
+@app.get("/api/telescopes/filters")
+def telescope_filters() -> dict[str, Any]:
+    """Which filter sits in each telescope, as far as the program knows.
+
+    A telescope with a connected wheel answers for itself; one without — a
+    RASA with a filter in a drawer at prime focus — has only what the
+    operator last said.  The Run button asks again every time, because a
+    drawer is changed by hand in the afternoon and nothing can detect it.
+    """
+    rows = []
+    for telescope in rigs.all:
+        wheel = telescope.manager.get("filterwheel")
+        rows.append({
+            "rig": telescope.id,
+            "name": telescope.name,
+            "role": "master" if telescope.is_master else "slave",
+            "hasWheel": bool(wheel is not None and wheel.connected),
+            "filter": str(telescope.config.get("camera", "fixedFilter", "") or ""),
+        })
+    return {"telescopes": rows}
+
+
+@app.post("/api/telescopes/filters")
+def set_telescope_filters(body: TelescopeFiltersRequest) -> dict[str, Any]:
+    """Record the filter fitted in each telescope named in the body.
+
+    Goes into that telescope's `camera.fixedFilter`, which is the one place
+    the rest of the program reads: the FITS header on every light, flat and
+    dark it takes from now on, the plan's allocation, the calibration library
+    and the warning when a night asks for a filter that is not there.
+    """
+    saved: dict[str, str] = {}
+    changed = False
+    for rig_id, name in body.filters.items():
+        telescope = _rig(rig_id)
+        clean = filters.canonical(name)
+        before = str(telescope.config.get("camera", "fixedFilter", "") or "")
+        _guard(telescope.config.update, "camera", {"fixedFilter": clean})
+        saved[telescope.id] = clean
+        changed = changed or (clean != before)
+        # The manager already prefixes a slave's lines with its name.
+        telescope.manager.log(
+            f"{clean or 'No filter'} in the light path"
+            + (f" (was {before})" if before and before != clean else ""))
+    if changed and collab_client.running:
+        # The collaboration server deals tonight's filter from the profile it
+        # was last told, and a drawer changed this afternoon is not in it
+        # until the next poll. Tell it now, off the request thread: the
+        # server may be slow or away, and the Run button is waiting.
+        def tell() -> None:
+            with contextlib.suppress(Exception):
+                collab_client.hello()
+        threading.Thread(target=tell, name="collab-filters", daemon=True).start()
+    return {"filters": saved}
+
+
+@app.post("/api/camera/cooler")
+def set_cooler(body: CoolerRequest, rig: str | None = None,
+               all: bool = False) -> dict[str, Any]:
+    """Cooler on or off, and the setpoint — on one camera, or with `all=true`
+    on every camera that is connected and can cool.
+
+    The cameras on one mount sit in the same air, so one setpoint for all of
+    them is the normal case, and a press of Cooler on that reached one of
+    three is how a night starts with two warm sensors.  A camera that cannot
+    take part is named, not skipped in silence.
+    """
+    # Cooling by hand outranks a warm-down left over from the last sequence,
+    # which would otherwise keep raising the setpoint under this.
+    if body.on or body.setpoint is not None:
+        sequencer.cancel_warming("the cooler was set by hand")
+    if not all:
+        target = _rig(rig)
+        camera = _guard(target.manager.require, "camera")
+        if body.setpoint is not None:
+            _guard(camera.set_setpoint, body.setpoint)
+            target.manager.log(f"Cooler setpoint {body.setpoint:g} C")
+        if body.on is not None:
+            _guard(camera.set_cooler, body.on)
+            target.manager.log(f"Cooler {'on' if body.on else 'off'}")
+        # So a camera reconnected after a failed frame comes back the same.
+        target.note_cooler(on=body.on, setpoint=body.setpoint)
+        return {"ok": True}
+
+    done: list[str] = []
+    skipped: list[dict[str, str]] = []
+    for telescope in rigs.all:
+        camera = telescope.manager.get("camera")
+        if camera is None or not camera.connected:
+            skipped.append({"rig": telescope.id, "name": telescope.name,
+                            "reason": "no camera connected"})
+            continue
+        if not getattr(camera, "can_cool", True):
+            skipped.append({"rig": telescope.id, "name": telescope.name,
+                            "reason": "this camera has no cooler"})
+            continue
+        try:
+            if body.setpoint is not None:
+                camera.set_setpoint(body.setpoint)
+                telescope.manager.log(f"Cooler setpoint {body.setpoint:g} C")
+            if body.on is not None:
+                camera.set_cooler(body.on)
+                telescope.manager.log(f"Cooler {'on' if body.on else 'off'}")
+            telescope.note_cooler(on=body.on, setpoint=body.setpoint)
+            done.append(telescope.name)
+        except DeviceError as exc:
+            skipped.append({"rig": telescope.id, "name": telescope.name,
+                            "reason": str(exc)})
+    if not done:
+        raise HTTPException(
+            status_code=400,
+            detail="; ".join(f"{s['name']}: {s['reason']}" for s in skipped)
+            or "no telescope has a camera connected")
+    return {"ok": True, "telescopes": done, "skipped": skipped}
+
+
+@app.post("/api/camera/settings")
+def set_camera_settings(body: CameraSettingsRequest,
+                        rig: str | None = None) -> dict[str, Any]:
+    target = _rig(rig)
